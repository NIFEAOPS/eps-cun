# ================================
# Distributed EPS + Pharmacy Platform
# ================================

# API gateway (JWT validation point)
VITE_API_GATEWAY_URL=https://api-gateway.example.com
VITE_AUTH_LOGIN_PATH=/auth/login

# Microservice URLs (if you call services directly from frontend)
VITE_APPOINTMENTS_SERVICE_URL=https://appointments-ms.example.com
VITE_MEDICATIONS_SERVICE_URL=https://medications-ms.example.com

# Frontend runtime
VITE_JWT_STORAGE_KEY=clinical_sanctuary_session
VITE_REQUEST_TIMEOUT_MS=15000

# -----------------------------------------------------------------
# Backend-only variables (DO NOT expose to the browser in production)
# Keep these in backend service environments, not in VITE_* variables.
# -----------------------------------------------------------------
APPOINTMENTS_DB_URL=postgresql://USER:PASSWORD@HOST:5432/appointments_db?sslmode=require
MEDICATIONS_DB_URL=postgresql://USER:PASSWORD@HOST:5432/medications_db?sslmode=require
